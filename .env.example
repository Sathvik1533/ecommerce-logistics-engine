# ==============================================================================
# Environment Configuration - E-Commerce Logistics Engine
# Safe default placeholders for local development and Docker Compose.
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Settings (MySQL 8.x)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DB_HOST=localhost
DB_PORT=3306
DB_USER=logistics_user
DB_PASSWORD=logistics_pass
DB_NAME=logistics_db
DATABASE_URL=mysql+pymysql://logistics_user:logistics_pass@localhost:3306/logistics_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis & Celery Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
